# Uso:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#
# estas variables se inyectan en tiempo de compilacion
# mediante String.fromEnvironment en lib/core/config/environment.dart
# No se leen en runtime como un archivo .env tradicional

# url base de la api backend
#
# ejemplos segun entorno:
#   Emulador Android:    http://10.0.2.2:8080
#   Dispositivo fisico:  http://192.168.1.100:8080
#   Produccion:          https://api.cosechaclima.example.com
#
# obligatorio en builds de produccion (--release)
# aqui modifica la url segun el metodo de ejecucion que uses
API_URL=
