---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CosechaClima - Tu semáforo climático para el campo">
  <!-- HEADER -->
  <header class="header">
    <div class="container header-content">
      <div class="logo-group">
        <h1 class="logo">Cosecha<span>Clima</span></h1>
        <span class="badge">Proyecto Open Source</span>
      </div>
      
      <div class="nav-actions">
        <a href="https://github.com/Abemilek/CosechaClima" target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="Repositorio GitHub">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
        <button id="themeToggle" class="icon-button" aria-label="Alternar tema claro/oscuro">
          <!-- Sol -->
          <svg id="sun-icon" class="theme-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Luna -->
          <svg id="moon-icon" class="theme-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="container hero-container">
      <p class="location-tag">📍 Carazo, Nicaragua · Monitoreo Agrícola</p>
      <h2 class="hero-title">Tu semáforo de decisiones climáticas para el campo</h2>
      <p class="hero-subtitle">
        CosechaClima traduce el clima en 3 acciones concretas para tu parcela — sin necesidad de un técnico agronómico presente todos los días.
      </p>
      
      <div class="hero-actions">
        <a href="#descarga" class="btn btn-primary btn-disabled" onclick="event.preventDefault();" title="Disponible muy pronto">Descargar APK (Próximamente)</a>
        <a href="https://github.com/Abemilek/CosechaClima" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          Ver código fuente
        </a>
      </div>
    </div>
  </section>

  <!-- FEATURES SECTION -->
  <section class="features">
    <div class="container">
      <div class="features-grid">
        
        <article class="feature-card">
          <div class="card-icon">🚦</div>
          <h3>Semáforo de riesgo</h3>
          <p>Cruza clima real, cultivo, etapa y tipo de suelo contra un motor de reglas agronómicas y te indica riesgo bajo, medio o alto.</p>
        </article>
        
        <article class="feature-card">
          <div class="card-icon">✅</div>
          <h3>3 acciones por alerta</h3>
          <p>Sin reportes técnicos largos. Cada alerta entrega exactamente 3 acciones prácticas a ejecutar hoy en la parcela.</p>
        </article>
        
        <article class="feature-card">
          <div class="card-icon">📍</div>
          <h3>GPS automático</h3>
          <p>Registra la parcela con un toque; la app detecta la ubicación para consultar el clima exacto de ese punto.</p>
        </article>
        
        <article class="feature-card">
          <div class="card-icon">📓</div>
          <h3>Bitácora de campo</h3>
          <p>Registro de acciones cumplidas e historial de alertas de la parcela consultables en cualquier momento.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- TRANSPARENCY SECTION -->
  <section class="transparency">
    <div class="container transparency-content">
      <h2>Transparencia y Open Source</h2>
      <p>
        CosechaClima es un proyecto <strong>100% de código abierto</strong>, auditado, seguro y diseñado para funcionar de forma ultra eficiente en entornos rurales. 
        No contiene rastreadores innecesarios ni telemetría invasiva; tus datos de campo te pertenecen.
      </p>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container footer-content">
      <p>&copy; {new Date().getFullYear()} CosechaClima.</p>
      <p>Desarrollo abierto en <a href="https://github.com/Abemilek/CosechaClima" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
    </div>
  </footer>

  <!-- SCRIPT PARA EL TOGGLE -->
  <script is:inline>
    const themeBtn = document.getElementById('themeToggle');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');

    // Inicializar íconos según el estado actual del HTML (seteado por Layout.astro)
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      sunIcon.style.display = 'block';
      moonIcon.style.display = 'none';
    } else {
      sunIcon.style.display = 'none';
      moonIcon.style.display = 'block';
    }

    themeBtn.addEventListener('click', () => {
      const element = document.documentElement;
      element.classList.toggle('dark');
      
      const isDarkNow = element.classList.contains('dark');
      localStorage.setItem('theme', isDarkNow ? 'dark' : 'light');
      
      if (isDarkNow) {
        sunIcon.style.display = 'block';
        moonIcon.style.display = 'none';
      } else {
        sunIcon.style.display = 'none';
        moonIcon.style.display = 'block';
      }
    });
  </script>
</Layout>

<style>
  /* ============================
     VARIABLES LOCALES Y UTILS
  ============================= */
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ============================
     HEADER
  ============================= */
  .header {
    border-bottom: 1px solid var(--border);
    background-color: var(--bg-color);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4.5rem;
  }

  .logo-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  
  .logo span {
    color: var(--accent);
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
    background-color: var(--surface-alt);
    color: var(--accent);
    border: 1px solid var(--border);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .icon-link, .icon-button {
    color: var(--text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .icon-link:hover, .icon-button:hover {
    color: var(--text-primary);
    background-color: var(--surface-alt);
  }

  /* ============================
     HERO
  ============================= */
  .hero {
    padding: 5rem 0;
    text-align: center;
  }

  .hero-container {
    max-width: 800px;
  }

  .location-tag {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin: 0 auto 2.5rem auto;
    max-width: 600px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    border-radius: 0.5rem;
    font-size: 1rem;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--accent);
    color: #FFFFFF;
    border: 1px solid var(--accent);
  }

  .btn-primary:hover:not(.btn-disabled) {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .btn-disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background-color: var(--surface-color);
    border-color: var(--text-secondary);
  }

  /* ============================
     FEATURES
  ============================= */
  .features {
    padding: 4rem 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background-color: var(--surface-color);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
    display: inline-block;
  }

  .feature-card h3 {
    margin: 0 0 0.75rem 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .feature-card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  /* ============================
     TRANSPARENCY
  ============================= */
  .transparency {
    padding: 4rem 0;
    background-color: var(--surface-alt);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .transparency-content {
    text-align: center;
    max-width: 700px;
  }

  .transparency h2 {
    margin: 0 0 1rem 0;
    font-size: 1.75rem;
  }

  .transparency p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  /* ============================
     FOOTER
  ============================= */
  .footer {
    padding: 3rem 0;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer a {
    color: var(--accent);
  }
  
  .footer a:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .logo-group {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    .badge {
      font-size: 0.6rem;
    }
    .header-content {
      height: auto;
      padding: 1rem 0;
    }
  }
</style>