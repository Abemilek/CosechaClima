# password del usuario sa de sql server requisitos de SQL Server
# minimo 8 caracteres, con mayusculas, minusculas, numeros y simbolos etc
DB_SA_PASSWORD=

# aqui debes usar exactamente la misma password que DB_SA_PASSWORD
# Server=db es el nombre del servicio dentro de compose.yaml, para que no pongas localhost
CONNECTION_STRING=Server=db;Database=BD_CosechaClima;User=sa;Password=CAMBIAME;TrustServerCertificate=True;

JWT_ISSUER=CosechaClimaAuth
JWT_AUDIENCE=CosechaClimaUsers

#la api no te ejecutara si dejas este campo vacio, puedes generar una con el comando openssl rand -base64 48
JWT_SECRET_KEY=

# 24 horas de vida del token
JWT_DURATION_MINUTES=1440

# Production deja Swagger oculto, redireccion HTTPS activa
# Development es recomendado para desarrollo local solamente
ASPNETCORE_ENVIRONMENT=Development

# client ids que el backend acepta al validar el ID Token que manda la
# app y se obtienen en Google Cloud Console puedes ver la GUIA-CONFIGURACION.md xd
# el de web es obligatorio es el que la app Flutter usa como serverClientId
# para que google emita un idToken
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# si se dejan vacios no se crea ningun admin y hay que hacerlo manualmente
# El correo debe ser valido y la contrasena de al menos 8 caracteres
# o el seed se omite con una advertencia en el log
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NOMBRE=Admin

# origen del frontend web permitido o sea la url, un ejemlo es http://localhost:5173
# puedes dejarlo vacio si solo consumiras la app movil pues etsa no usa cors xd
CORS_ALLOWED_ORIGIN=
