# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL 18)
# ---------------------------------------------------------------------------
# Superusuario "postgres": solo administracion, la API no lo usa. Genera una clave larga:
#   openssl rand -base64 24
DB_ADMIN_PASSWORD=

# Clave del rol de la aplicacion (cosechaclima_app, sin privilegios de superusuario).
# Debe ser EXACTAMENTE la misma que pongas dentro de CONNECTION_STRING.
# Solo se aplica la primera vez que se crea el volumen de datos; si ya existe, cambiala con
# ALTER ROLE cosechaclima_app PASSWORD '...';
DB_APP_PASSWORD=

# Opcionales (valores por defecto: cosechaclima / cosechaclima_app)
# DB_NAME=cosechaclima
# DB_APP_USER=cosechaclima_app

# Host=db es el nombre del servicio en compose.yaml (no uses localhost dentro de docker).
# Dentro de la red de docker no hay TLS; si la base esta en OTRO servidor/nube usa
# "SSL Mode=VerifyFull" (o al menos Require) y revisa el certificado.
# Si la clave tiene ; o espacios, enciérrala entre comillas simples dentro de la cadena.
CONNECTION_STRING=Host=db;Port=5432;Database=cosechaclima;Username=cosechaclima_app;Password=CAMBIAME;Maximum Pool Size=20;Application Name=cosechaclima-api

# ---------------------------------------------------------------------------
# JWT y sesiones
# ---------------------------------------------------------------------------
JWT_ISSUER=CosechaClimaAuth
JWT_AUDIENCE=CosechaClimaUsers

#la api no te ejecutara si dejas este campo vacio, puedes generar una con el comando openssl rand -base64 48
JWT_SECRET_KEY=

# Vida del access token en minutos. 15 es lo recomendado: la sesion larga la mantiene el
# refresh token (rotado en cada uso). La API avisa en el log si pones mas de 60.
JWT_DURATION_MINUTES=15

# Dias de vida (deslizante) del refresh token. Tope absoluto por inicio de sesion: 180 dias.
JWT_REFRESH_DAYS=30

# Cookie del refresh token del Admin Console. Dejala en true siempre que uses HTTPS.
# Solo ponla en false para probar el panel por http://localhost sin TLS.
AUTH_COOKIE_SECURE=true

# Production deja Swagger oculto, redireccion HTTPS activa
# Development es recomendado para desarrollo local solamente
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# Proxy inverso / balanceador (nginx, Caddy, Traefik, nube...)
# ---------------------------------------------------------------------------
# Si la API corre DETRAS de un proxy, declara su IP (o red en notacion CIDR) para que la API
# lea la IP real del cliente desde X-Forwarded-For. Sin esto el rate limiting por IP veria
# siempre la IP del proxy y bloquearia a todos a la vez. Si no hay proxy, dejalos vacios:
# las cabeceras X-Forwarded-* se ignoran (nadie puede falsear su IP).
# Ejemplos: PROXY_KNOWN_PROXY=10.0.0.5   |   PROXY_KNOWN_NETWORK=172.18.0.0/16
PROXY_KNOWN_PROXY=
PROXY_KNOWN_NETWORK=

# ---------------------------------------------------------------------------
# Google Sign-In
# ---------------------------------------------------------------------------
# client ids que el backend acepta al validar el ID Token que manda la
# app y se obtienen en Google Cloud Console puedes ver la GUIA-CONFIGURACION.md xd
# el de web es obligatorio es el que la app Flutter usa como serverClientId
# para que google emita un idToken
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# si se deja vacio no se crea ningun admin y hay que asignar el rol
# manualmente en la base de datos
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NOMBRE=Admin

# ---------------------------------------------------------------------------
# CORS y Admin Console
# ---------------------------------------------------------------------------
# origen del frontend web permitido o sea la url, un ejemlo es http://localhost:5173
# puedes dejarlo vacio si solo consumiras la app movil pues etsa no usa cors xd
CORS_ALLOWED_ORIGIN=

# origen desde el que se sirve el Admin Console, para que el backend lo
# acepte por CORS. Con docker compose por defecto es este puerto http://localhost:5174
# pero modificalo segun tus configuraciones
ADMIN_CONSOLE_ORIGIN=

# URL de la API que el Admin Console usa en el navegador. Se "hornea" dentro
# del build de la imagen (es una app estatica sin servidor propio), asi que
# si la cambias hay que reconstruir: docker compose build adminconsole
# por defecto es http://localhost:8080 pero cambiala segun tus configuraciones
# IMPORTANTE: el panel y la API deben ser del MISMO "sitio" (mismo dominio registrable, por
# ejemplo admin.midominio.com y api.midominio.com) para que la cookie SameSite=Strict del
# refresh token viaje. localhost:5174 -> localhost:8080 cuenta como mismo sitio.
ADMIN_CONSOLE_API_URL=
