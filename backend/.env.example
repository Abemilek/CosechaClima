# bd de sql server
DB_SA_PASSWORD=cambiarestaclave

# db es el nombre del servicio dentro de docker-compose no localhost
CONNECTION_STRING=Server=db;Database=BD_CosechaClima;User Id=sa;Password=cambiarestaclave;TrustServerCertificate=True;

# autenticacion
JWT_ISSUER=CosechaClimaAPI
JWT_AUDIENCE=CosechaClimaApp
JWT_SECRET_KEY=generarunaclaveaqui
JWT_DURATION_MINUTES=1440

# entorno de ejecucion
ASPNETCORE_ENVIRONMENT=Development

# admin inicial opcional, si se deja vacio no se crea ningun admin
# y hay que registrarlo a mano (ver README)
ADMIN_SEED_TELEFONO=
ADMIN_SEED_PIN=
ADMIN_SEED_NOMBRE=Admin

# origen del frontend permitido para CORS, ej. http://localhost:5173
CORS_ALLOWED_ORIGIN=